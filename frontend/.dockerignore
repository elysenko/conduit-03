# The builder stage either reuses the prebaked /opt/colossus/angular-warmup
# node_modules or runs `npm install`. A host-installed node_modules must never
# reach the build context: the later `COPY . .` would clobber that directory
# with host-arch native binaries (e.g. @esbuild/linux-x64), breaking the
# ARM64 production build.
node_modules

# Build output and caches — regenerated by `npm run build` inside the image.
dist
.angular
out-tsc
coverage

# Local-only noise.
.env
.env.*
*.log
