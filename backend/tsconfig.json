{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // Deliberately NOT incremental. `tsc --noEmit -p tsconfig.build.json`
    // (the typecheck script) writes tsconfig.build.tsbuildinfo; a later
    // `nest build` deletes dist/ (deleteOutDir), trusts that cache as
    // up-to-date and emits nothing — yielding an image with no
    // dist/main.js. Any pipeline that typechecks before building hits it.
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "paths": {}
  }
}
