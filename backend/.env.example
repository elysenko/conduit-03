# Conduit backend environment.
# Copy to backend/.env for local development; in Kubernetes these come from the
# platform secret. Only DATABASE_URL and JWT_SECRET are required — every
# third-party credential below is optional and degrades the feature that needs
# it (HTTP 503) instead of failing startup.

# Required — provisioned by the platform.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me-in-every-environment

# Optional.
PORT=3001
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4200

# Optional object storage, configurable at runtime via /admin/settings.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
