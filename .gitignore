# Dependencies — regenerated by `npm ci` during the deploy build; never committed.
node_modules/

# Build output — regenerated by `npm run build` during the deploy build.
dist/
out-tsc/
/tmp/

# Angular build cache
.angular/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
*.swp

# TypeScript incremental build cache. Must never be committed or copied into a
# build context: `nest build` deletes dist/ then trusts this cache and emits
# nothing, producing a runtime image with no dist/main.js.
*.tsbuildinfo
